<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    父 POM：Spring Boot 3.5.16 + Java 21
    - Boot 3.5.16 是 3.5 线最后一个 OSS 补丁版本（OSS 支持已于 2026-06-30 结束），与 ①②③ 家族保持一致
    - JDK 21 是虚拟线程（loomguard 的全部能力）的硬前提
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nephets</groupId>
  <artifactId>loomguard</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>loomguard</name>
  <description>JDK 21 虚拟线程落地防护库：运行时检测 pinning（JFR jdk.VirtualThreadPinned）、审计 ThreadLocal 内存风险、发现虚拟线程误用，并提供 Spring Boot 自动装配与 Actuator 端点。</description>
  <url>https://github.com/nephets/loomguard</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nephets</id>
      <name>loomguard maintainers</name>
      <url>https://github.com/nephets</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/nephets/loomguard</url>
    <connection>scm:git:https://github.com/nephets/loomguard.git</connection>
  </scm>

  <modules>
    <module>loomguard-core</module>
    <module>loomguard-starter</module>
    <module>loomguard-sample</module>
  </modules>

  <!--
    ★ 预先定义一个空的 argLine 属性。
      surefire / failsafe 用 @{argLine} 引用它，jacoco:prepare-agent 在运行期把
      -javaagent:... 注入进来。若不预先定义 argLine，@{argLine} 会保持字面量不被解析，
      导致 jacoco 找不到执行数据 —— 覆盖率报告为空，而 check 规则会因「无数据」静默通过。
      那比没有门禁更危险：它会让人误以为覆盖率已达标。
  -->
  <properties>
    <argLine></argLine>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <assertj.version>3.27.3</assertj.version>
    <spotless.version>2.44.4</spotless.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <jacoco.version>0.8.15</jacoco.version>

    <!-- ==== 覆盖率门禁 ==== -->
    <!--
      显式声明为 false：部分环境的 Maven 会给 jacoco.skip 注入默认值，
      导致 report/check 被静默跳过 —— 覆盖率报告为空而构建照样成功，
      这比没有门禁更危险（会让人误以为覆盖率已达标）。
    -->
    <jacoco.skip>false</jacoco.skip>
    <jacoco.line.minimum>0.60</jacoco.line.minimum>
    <jacoco.line.minimum.core>0.75</jacoco.line.minimum.core>
    <!--
      ★ 覆盖率执行数据存放位置。
      本仓库路径（repos/loomguard）本身已是纯 ASCII，直接用 target 目录即可：
      既不会被「中文路径下 -javaagent 参数被截断」问题影响（①②③ 踩过的坑），
      又被 `mvn clean` 一并清掉，不会留下「上一轮构建的 .exec」污染本轮覆盖率。
      父 pom（packaging=pom）没有测试执行数据，显式跳过 report/check。
    -->
    <jacoco.dest.dir>${project.build.directory}/${project.artifactId}.exec</jacoco.dest.dir>
    <jacoco.report.skip>true</jacoco.report.skip>
    <jacoco.coverage>enabled</jacoco.coverage>

    <!--
      测试 JVM 堆大小。显式设限的原因：loomguard 的探针要在测试里反复 new Recording() 并启动虚拟线程，
      JVM 默认堆在内存受限的机器/容器上可能被判定为「虚拟空间不足」而直接崩溃，
      且报错信息完全指不到真实原因（只说 forked VM terminated）。
      512m 足以跑完全部用例；内存更紧张的机器可用 -Dswy.test.heap=256m 覆盖。
    -->
    <swy.test.heap>512m</swy.test.heap>
    <swy.failsafe.heap>768m</swy.failsafe.heap>

    <maven.javadoc.skip>false</maven.javadoc.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 本仓模块 -->
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>loomguard-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>loomguard-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 三方 -->
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <!--
              显式限制 fork 出的测试 JVM 堆大小。@{argLine} 占位符保证 jacoco 注入的
              agent 参数不会被覆盖。
            -->
            <argLine>@{argLine} -Xmx${swy.test.heap} -Xms64m -XX:+ExitOnOutOfMemoryError</argLine>
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <argLine>@{argLine} -Xmx${swy.failsafe.heap}</argLine>
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        ★ 刻意不在父 POM 的 <dependencies> 里声明通用依赖。
          若在此声明 spring-boot-starter-test，则 core 模块 dependency:analyze 必然报出
          一堆「声明未使用」的传递依赖，让「core 零 Spring 依赖」这条边界无法用机器判定。
          各子模块按需显式声明自己真正用到的依赖。
      -->

      <!-- ==== 强制 Java 21 与 Maven 版本 ==== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>本项目需要 JDK 21（使用虚拟线程与 record pattern）。当前 JAVA_HOME=$(java.home)</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ==== 统一代码格式：google-java-format + Apache-2.0 许可证头 ==== -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-apply</id>
            <goals>
              <goal>apply</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <!--
              ★ Apache-2.0 许可证头由 spotless 的 licenseHeader 规则强制校验，
                 CI 的 spotless:check 阶段会因此失败（缺头文件即红）。
            -->
            <licenseHeader>
              <file>${maven.multiModuleProjectDirectory}/LICENSE-HEADER.txt</file>
            </licenseHeader>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>com,io,org,javax,java,\#</order>
            </importOrder>
          </java>
          <formats>
            <format>
              <includes>
                <include>*.md</include>
                <include>docs/**/*.md</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
      </plugin>

      <!-- ==== 覆盖率：core ≥ 75%，其余 ≥ 60% ==== -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dest.dir}</destFile>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <!--
                ★ 集成测试的数据「追加」到与单元测试相同的文件，而不是另存 -it.exec 再 merge。
                理由：jacoco:merge 的 fileSet 语义在「某些文件不存在」时会直接报 fileSets 缺失
                （core 模块就没有 *IT.java），踩过一次就够了。让两份数据自然累积到一个文件，
                既省掉 merge 这一步，也彻底消除那类只在特定模块组合下复现的构建故障。
              -->
              <destFile>${jacoco.dest.dir}</destFile>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.dest.dir}</dataFile>
              <formats>
                <format>HTML</format>
                <format>XML</format>
                <format>CSV</format>
              </formats>
            </configuration>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <dataFile>${jacoco.dest.dir}</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
